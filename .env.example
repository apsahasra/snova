# Copy to .env only if you want to use your own Postgres.
# If DATABASE_URL is empty, `npm run dev` starts a private embedded Postgres in ./.pgdata

# Postgres connection string (Neon / Render / local). Required in production.
DATABASE_URL=

# Port the HTTP server listens on
PORT=3000

# Set to "production" on the host. Disables the embedded database fallback.
NODE_ENV=development

# Passwords for the seed users created by `npm run seed`.
# Leave empty to use the demo passwords documented in the README.
SEED_ADMIN_PASSWORD=
SEED_AUDITOR_PASSWORD=
SEED_ALICE_PASSWORD=
SEED_BOB_PASSWORD=
